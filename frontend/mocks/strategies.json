                    "side": "LONG",
                    "weight": 1.5,
                    "all": [
                        {
                            "feature": "rel_strength_20",
                            "op": "gt",
                            "value": 0.001
                        }
                    ]
                },
                {
                    "id": "macd_confirms",
                    "description": "MACD histogram is positive and expanding",
                    "side": "LONG",
                    "weight": 1,
                    "all": [
                        {
                            "feature": "macd_hist",
                            "op": "gt",
                            "value": 0
                        }
                    ]
                },
                {
                    "id": "volume_participation",
                    "description": "Volume is above its twenty period average",
                    "side": "LONG",
                    "weight": 1,
                    "all": [
                        {
                            "feature": "volume_ratio_20",
                            "op": "gte",
                            "value": 1.1
                        }
                    ]
                },
                {
                    "id": "overbought_stretch",
                    "description": "RSI is in overbought territory and price is stretched above the upper band",
                    "side": "LONG",
                    "weight": 1.5,
                    "all": [
                        {
                            "feature": "rsi_14",
                            "op": "gt",
                            "value": 78
                        },
                        {
                            "feature": "bb_percent_b",
                            "op": "gt",
