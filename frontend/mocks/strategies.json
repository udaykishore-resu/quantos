        {
            "id": "quality_growth",
            "name": "Quality Growth",
            "version": "1.0.0",
            "description": "Looks for durable businesses whose price action is not fighting the thesis. The fundamental weighting dominates the composite score, while the technical rules exist only to avoid buying into an active breakdown. This strategy is regime-agnostic by design: quality is a slow-moving property and gating it on an intraday regime would add noise rather than remove it. The risk engine still applies in full.\n",
            "enabled": true,
            "interval": "1m",
            "rules": [
                {
                    "id": "constructive_trend",
                    "description": "Price is above the 50 period average, so the tape is not fighting the thesis",
                    "side": "LONG",
                    "weight": 2,
                    "all": [
                        {
                            "feature": "last",
                            "op": "gt",
                            "value": 0,
                            "other": "sma_50"
