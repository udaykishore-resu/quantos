            "modified_at": "2026-08-27T23:16:40.983578262Z"
        },
        {
            "id": "momentum",
            "name": "Trend Momentum",
            "version": "1.2.0",
            "description": "Buys established up-trends that are still being confirmed by participation. The thesis is that a trend with rising relative strength, an ADX above the trending threshold and above-average volume is more likely to persist over an intraday-to-daily horizon than to reverse. It is deliberately restricted to trending and breakout regimes: the same rules in a range produce a stream of losing signals, which is the classic failure of applying indicators blindly.\n",
            "enabled": true,
            "interval": "1m",
            "regimes": [
                "BULL_TREND",
                "BREAKOUT",
                "RISK_ON"
            ],
            "rules": [
                {
                    "id": "price_above_fast_and_slow",
                    "description": "Price is above both the 20 and 50 period moving averages",
                    "side": "LONG",
                    "weight": 2,
                    "all": [
                        {
                            "feature": "last",
                            "op": "gt",
                            "value": 0,
                            "other": "sma_20"
                        },
                        {
                            "feature": "last",
                            "op": "gt",
                            "value": 0,
                            "other": "sma_50"
                        }
                    ]
                },
                {
                    "id": "trend_is_directional",
                    "description": "ADX confirms a directional market rather than chop",
                    "side": "LONG",
                    "weight": 2,
                    "all": [
                        {
                            "feature": "adx_14",
                            "op": "gte",
                            "value": 22
                        },
                        {
                            "feature": "plus_di_14",
                            "op": "gt",
                            "value": 0,
                            "other": "minus_di_14"
                        }
                    ]
                },
                {
                    "id": "above_vwap",
                    "description": "Price is trading above the session VWAP",
                    "side": "LONG",
                    "weight": 1.5,
                    "all": [
                        {
                            "feature": "vwap_dist_bps",
                            "op": "gt",
                            "value": 5
