# QuantOS dashboard configuration.
#
# Every value has a working default, so this file is an override sheet rather
# than a requirement. Copy to .env.local to use it.
#
# Note what is NOT here: no provider API key, and no secret the browser could
# reach. The API bearer token is obtained and held in the Next.js server
# process; browser code talks only to this app's own same-origin proxy.

# Origin of the Go API.
QUANTOS_API_URL=http://localhost:8080

# A pre-issued bearer token. Preferred in any real deployment: the dashboard
# then holds no credential of its own at all. When set, the dev login below is
# not used.
# QUANTOS_API_TOKEN=

# Local development principals, matching auth.dev_users in config/quantos.yaml.
# `operator` is the default because it also holds audit:read, which the Settings
# page uses. `demo`/`demo` works too, with that one panel reporting a 403.
QUANTOS_DEV_SUBJECT=operator
QUANTOS_DEV_PASSWORD=operator

# Serve mocks/ instead of a live backend. See mocks/README.md.
# QUANTOS_USE_MOCKS=1

# Server-side cache window, in seconds, for list reads. 0 disables caching.
QUANTOS_REVALIDATE_SECONDS=5
